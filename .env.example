# =====================================================================
#  Greenbloom — environment template
# =====================================================================
#  Copy this file to .env.local and fill in real values for local dev.
#  For production, set these in your hosting provider's dashboard
#  (e.g. Vercel → Project → Settings → Environment Variables).
# =====================================================================

# --- fal.ai (image generation, REQUIRED) ---------------------------
# Server-side only. Do NOT prefix with NEXT_PUBLIC_.
FAL_KEY=

# --- Upstash Redis (rate limiting, recommended for production) -----
# When both are set, /api/generate enforces per-IP and global limits.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Cloudflare Turnstile (bot protection, recommended for prod) ---
# When both are set, /api/generate requires a valid captcha token.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- AWS S3 (optional, for restoring the theme gallery) ------------
# AWS_REGION=
# AWS_ROLE_ARN=
# S3_BUCKET_NAME=
